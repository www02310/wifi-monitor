# ── 运行期数据（含历史断网记录，属于本机数据，不要提交） ──────────
data/
logs/
reports/
config.json
WiFi/

# ── 打包产物与中间文件 ──────────────────────────────────────────
# dist/ 里是 13MB 的 exe，不适合进 git。
# 若确实想随仓库分发，用 git add -f dist/WiFiMonitor.exe 单独强加。
build/
dist/
*.spec

# ── Python 缓存 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 原始文件备份（重写前的旧版本，确认无误后可删） ─────────────
*.orig.bak

# ── Markdown 文档（除 README 外，不提交） ───────────────────────────
*.md
!README.md

# ── 编辑器与系统 ──────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
